[info]
name = "obsidian"
description = "A red/black colored theme for WeeChat"
date = "2026-10-31 11:37:40"
weechat = "4.10.1"

[options]
buflist.format.buffer = "${format_number}${indent}${format_nick_prefix}${color_hotlist}${format_name}${format_hotlist}"
buflist.format.buffer_current = "${color:,52}${format_buffer}"
buflist.format.hotlist = " ${color:167}[${hotlist}${color:167}]"
buflist.format.hotlist_highlight = "${color:196}"
buflist.format.hotlist_low = "${color:242}"
buflist.format.hotlist_message = "${color:250}"
buflist.format.hotlist_none = "${color:246}"
buflist.format.hotlist_private = "${color:167}"
buflist.format.hotlist_separator = "${color:240},"
buflist.format.indent = "${color:238}  "
buflist.format.lag = " ${color:240}[${color:167}${lag}${color:240}]"
buflist.format.name = "${name}"
buflist.format.nick_prefix = "${color:167}${nick_prefix}"
buflist.format.number = "${color:160}${number}${if:${number_displayed}?.: }"
buflist.format.tls_version = " ${color:240}(${if:${tls_version}==TLS1.3?${color:250}:${if:${tls_version}==TLS1.2?${color:167}:${color:196}}}${translate:${tls_version}}${color:240})"
exec.color.flag_finished = lightred
exec.color.flag_running = lightgreen
fset.format.option2 = "${marked} ${name}  ${type}  ${value2}${newline}  ${empty_name}  ${_default_value}${color:244} -- ${_allowed_values}${newline}  ${empty_name}  ${_description}"
fset.color.allowed_values = default
fset.color.allowed_values_selected = white
fset.color.color_name = 246
fset.color.color_name_selected = default
fset.color.default_value = default
fset.color.default_value_selected = white
fset.color.description = 242
fset.color.description_selected = default
fset.color.file = default
fset.color.file_changed = brown
fset.color.file_changed_selected = yellow
fset.color.file_selected = white
